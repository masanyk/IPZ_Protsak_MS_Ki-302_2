<Window
    Height="500"
    Title="WeatherApp"
    Width="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_17.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="Styles.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            VerticalAlignment="Top">
            <ComboBox
                ItemsSource="{Binding Cities}"
                SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                Width="250" />
            <Button
                Command="{Binding AddLocationCommand}"
                Content="Add Location"
                Width="150" />
        </StackPanel>

        <TextBlock
            FontSize="18"
            HorizontalAlignment="Center"
            Margin="0,70,0,0"
            Text="{Binding WeatherInfo}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="500" />

        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            VerticalAlignment="Bottom">
            <Button
                Command="{Binding OpenWeatherDetailsCommand}"
                Content="Переглянути історію"
                Width="180" />
            <Button
                Command="{Binding SaveWeatherCommand}"
                Content="Зберегти в історію"
                Width="180" />
            <Button
                Command="{Binding PredictWeatherCommand}"
                Content="Переглянути можливу погоду"
                Width="230" />
        </StackPanel>
    </Grid>
</Window>