<Window
    Height="450"
    Title="PredictedWeather"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_17.Pages.PredictedWeather"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../Styles.xaml" />
    </Window.Resources>
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            Margin="20"
            VerticalAlignment="Center">
            <!--  Виводимо назву міста  -->
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Margin="0,0,0,10"
                Text="{Binding CityName}" />

            <!--  Виводимо температуру  -->
            <TextBlock
                FontSize="20"
                Margin="0,0,0,10"
                Text="{Binding Weather.Temperature}" />

            <!--  Виводимо опис погоди  -->
            <TextBlock
                FontSize="16"
                Margin="0,0,0,10"
                Text="{Binding Weather.Description}"
                TextWrapping="Wrap" />

            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Foreground="Red"
                Margin="0,20,0,0"
                Text="Увага! Це попередній прогноз. Дані можуть змінюватися залежно від погодних умов. Будь ласка, перевіряйте актуальні прогнози погоди."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>