<Window
    Height="450"
    Title="WeatherDetailsWindow"
    Width="560"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="lab2_17.WeatherDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:lab2_17"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <ResourceDictionary Source="../Styles.xaml" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок міста, буде на всю ширину  -->
        <TextBlock
            FontSize="30"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="0,20,0,20"
            Text="{Binding SelectedCity}" />

        <!--  Кнопка закриття у правому верхньому куті  -->
        <Button
            Click="CloseButton_Click"
            Content="Закрити"
            FontSize="16"
            Grid.Row="0"
            HorizontalAlignment="Right"
            Margin="20,10,20,0"
            VerticalAlignment="Top"
            Width="150" />

        <!--  Список з історією погоди у першій колонці  -->
        <ListBox
            FontSize="16"
            Grid.Column="0"
            Grid.Row="1"
            ItemsSource="{Binding WeatherHistory}"
            Margin="20"
            VerticalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--  Сітка для розділення на 2 колонки  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <!--  Для назви  -->
                            <ColumnDefinition Width="*" />
                            <!--  Для кнопки  -->
                        </Grid.ColumnDefinitions>

                        <!--  Текст погоди в першій колонці  -->
                        <TextBlock
                            Grid.Column="0"
                            Margin="10,0"
                            Text="{Binding}"
                            VerticalAlignment="Center"
                            Width="300" />

                        <!--  Кнопка "Оновити погоду" в другій колонці  -->
                        <Button
                            Click="ShowWeatherButton_Click"
                            CommandParameter="{Binding}"
                            Content="Оновити погоду"
                            FontSize="16"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            Width="150" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
